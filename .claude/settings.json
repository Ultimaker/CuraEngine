{
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "claudeMdExcludes": [
    "**/software/sdk/**",
    "**/vendor/**",
    "**/third_party/**"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/pretool_guard.py"
          },
          {
            "type": "command",
            "command": "python .agents/hooks/block_name_matched_kill.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .agents/hooks/post_edit_check.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ecdsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/*.gpg)",
      "Read(./**/*.asc)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.env-*)",
      "Read(./**/.env_*)",
      "Read(./**/*.tfvars)",
      "Read(./**/.netrc)",
      "Read(./**/.npmrc)",
      "Read(./**/credentials.json)",
      "Read(./**/service-account*.json)",
      "Read(./**/secrets/**)",
      "Read(./**/vendor/**)",
      "Read(./**/third_party/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/build/**)",
      "Read(./**/dist/**)",
      "Read(./**/out/**)",
      "Read(./**/target/**)",
      "Read(./**/.venv/**)",
      "Read(./**/venv/**)",
      "Read(./**/__pycache__/**)",
      "Read(./**/*.o)",
      "Read(./**/*.a)",
      "Read(./**/*.so)",
      "Read(./**/*.dylib)",
      "Read(./**/*.dll)",
      "Read(./**/*.exe)",
      "Read(./**/.mypy_cache/**)",
      "Read(./**/.pytest_cache/**)",
      "Read(./**/.ruff_cache/**)",
      "Read(./**/*.stl)",
      "Read(./**/*.3mf)",
      "Read(./**/*.ufp)",
      "Read(./**/*.obj)",
      "Read(./**/*.step)",
      "Read(./**/*.stp)",
      "Read(./**/uv.lock)",
      "Read(./**/poetry.lock)",
      "Read(./**/*.log)",
      "Read(./**/logdump*/**)",
      "Read(./**/customer-data/**)",
      "Read(./**/pii/**)"
    ]
  }
}
